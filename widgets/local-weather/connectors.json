{
  "composite_connectors": [
    {
      "name": "Weather by Zip Code",
      "permalink": "weather-by-zip",
      "steps": [
        {
          "name": "zip-to-coords",
          "url": "https://api.zippopotam.us/us/80602",
          "method": "GET",
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "overridable": false
            }
          ]
        },
        {
          "name": "weather-forecast",
          "url": "https://api.open-meteo.com/v1/forecast",
          "method": "GET",
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "overridable": false
            }
          ],
          "query_parameters": [
            {
              "key": "latitude",
              "value": "{{ (steps.zip-to-coords.body | from_json).places[0].latitude }}"
            },
            {
              "key": "longitude",
              "value": "{{ (steps.zip-to-coords.body | from_json).places[0].longitude }}"
            },
            {
              "key": "daily",
              "value": "temperature_2m_max,temperature_2m_min,weathercode",
              "overridable": false
            },
            {
              "key": "timezone",
              "value": "auto",
              "overridable": false
            },
            {
              "key": "forecast_days",
              "value": "7",
              "overridable": true
            }
          ]
        }
      ]
    }
  ]
}
