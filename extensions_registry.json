{
  "widgets": [
    {
      "version": "1.0.0",
      "title": "Athena Widget",
      "description": "A React widget using the ESM module pattern with Widget SDK to leverage CC Data Lake information via Athena Service",
      "category": "Demo",
      "imageSrc": "widgets/athena_widget/thumbnail.png",
      "source": {
        "path": "widgets/athena_widget/dist",
        "entry": "index.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "AWSRegion",
            "type": "text",
            "label": "Region",
            "defaultValue": "us-west-2",
            "rules": {
              "required": true
            }
          },
          {
            "name": "AWSBucket",
            "type": "text",
            "label": "AWS Bucket",
            "defaultValue": "production-insided-data-repository-us-west-2",
            "rules": {
              "required": true
            }
          }
        ]
      },
      "defaultConfig": {
        "AWSRegion": "us-west-2",
        "AWSBucket": ""
      },
      "type": "athena_widget"
    },
    {
      "version": "1.0.0",
      "title": "Card Grid",
      "description": "A configurable card grid widget demonstrating dynamic layout and styling options",
      "category": "Demo",
      "imageSrc": "widgets/card_grid/thumbnail.png",
      "configuration": {
        "properties": [
          {
            "name": "cards_per_row",
            "type": "number",
            "label": "Cards Per Row",
            "defaultValue": 3,
            "rules": {
              "required": true,
              "minimum": 1,
              "maximum": 6
            }
          },
          {
            "name": "card_background",
            "type": "color",
            "label": "Card Background",
            "defaultValue": "#ffffff"
          },
          {
            "name": "card_text_color",
            "type": "color",
            "label": "Text Color",
            "defaultValue": "#1f2937"
          },
          {
            "name": "accent_color",
            "type": "color",
            "label": "Accent Color",
            "defaultValue": "#3b82f6"
          },
          {
            "name": "title_size",
            "type": "select",
            "label": "Title Size",
            "defaultValue": "medium",
            "options": [
              {
                "value": "small",
                "label": "Small"
              },
              {
                "value": "medium",
                "label": "Medium"
              },
              {
                "value": "large",
                "label": "Large"
              }
            ]
          },
          {
            "name": "card_style",
            "type": "select",
            "label": "Card Style",
            "defaultValue": "shadow",
            "options": [
              {
                "value": "flat",
                "label": "Flat"
              },
              {
                "value": "shadow",
                "label": "Shadow"
              },
              {
                "value": "bordered",
                "label": "Bordered"
              }
            ]
          },
          {
            "name": "show_icons",
            "type": "select",
            "label": "Show Icons",
            "defaultValue": "yes",
            "options": [
              {
                "value": "yes",
                "label": "Yes"
              },
              {
                "value": "no",
                "label": "No"
              }
            ]
          }
        ]
      },
      "defaultConfig": {
        "cards_per_row": 3,
        "card_background": "#ffffff",
        "card_text_color": "#1f2937",
        "accent_color": "#3b82f6",
        "title_size": "medium",
        "card_style": "shadow",
        "show_icons": "yes"
      },
      "source": {
        "path": "widgets/card_grid/dist",
        "entry": "content.html"
      },
      "type": "card_grid"
    },
    {
      "version": "1.0.0",
      "title": "Demo widget",
      "description": "Demo widget for presentation purposes",
      "category": "Demo",
      "imageSrc": "widgets/demo_widget/thumbnail.png",
      "source": {
        "path": "widgets/demo_widget/dist",
        "entry": "content.html"
      },
      "type": "demo_widget"
    },
    {
      "title": "Local weather",
      "description": "A widget showing a users local weather",
      "category": "Demo",
      "source": {
        "path": "widgets/local-weather/dist",
        "entry": "content.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "defaultValue": "Local weather",
            "rules": {
              "required": true
            }
          },
          {
            "name": "description",
            "type": "text",
            "label": "Description",
            "defaultValue": "A widget showing a users local weather"
          }
        ]
      },
      "defaultConfig": {
        "title": "Local weather",
        "description": "A widget showing a users local weather"
      },
      "type": "local-weather"
    },
    {
      "version": "1.0.0",
      "title": "React Widget",
      "description": "A React widget using the ESM module pattern with Widget SDK",
      "category": "Demo",
      "imageSrc": "widgets/react_widget/thumbnail.png",
      "source": {
        "path": "widgets/react_widget/dist",
        "entry": "index.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "defaultValue": "React Widget",
            "rules": {
              "required": true
            }
          },
          {
            "name": "description",
            "type": "text",
            "label": "Description",
            "defaultValue": "A widget built with React and the Widget SDK."
          }
        ]
      },
      "defaultConfig": {
        "title": "React Widget",
        "description": "A widget built with React and the Widget SDK."
      },
      "type": "react_widget"
    },
    {
      "version": "1.0.0",
      "title": "Subscribe Button",
      "description": "Subscribe or unsubscribe from a category driven by a ?categoryId= URL query parameter. Uses the ChWebSdk Subscription API.",
      "category": "Custom",
      "containers": [
        "Full width",
        "Left container",
        "Sidebar"
      ],
      "source": {
        "path": "widgets/subscribe_button/dist",
        "entry": "content.html"
      },
      "type": "subscribe_button"
    }
  ],
  "stylesheets": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "name": "theme",
      "description": "Shared design tokens and component styles",
      "path": "./stylesheets/theme/style.css"
    }
  ],
  "scripts": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "placement": "head",
      "name": "analytics",
      "description": "Tracks widget impressions and interactions",
      "path": "./scripts/analytics/script.js"
    },
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "placement": "head",
      "name": "cachetesting",
      "description": "testing caching issues with sync",
      "path": "./scripts/cachetesting/script.js"
    }
  ]
}
